DOMAIN_NAME=feedback.example.com
BASE_URL=https://feedback.example.com
BETTER_AUTH_URL=https://feedback.example.com
BETTER_AUTH_SECRET=            # openssl rand -base64 32
POSTGRES_PASSWORD=             # openssl rand -hex 24
WEB_PORT=3040

STORAGE_PROVIDER=s3
STORAGE_REGION=eu-central-1
STORAGE_BUCKET_NAME=
NEXT_PUBLIC_STORAGE_BASE_URL=  # https://<bucket>.s3.<region>.amazonaws.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

MAIL_PROVIDER=ses
SES_REGION=eu-central-1
MAIL_DOMAIN=example.com        # must be a verified SES identity

INNGEST_EVENT_KEY=             # openssl rand -hex 32
INNGEST_SIGNING_KEY=           # openssl rand -hex 32 (hex only)

# Integration routes refuse to load without these, even when unused.
LINEAR_TOKEN_ENCRYPTION_KEY=   # openssl rand -hex 32
JIRA_TOKEN_ENCRYPTION_KEY=     # openssl rand -hex 32
SLACK_TOKEN_ENCRYPTION_KEY=    # openssl rand -hex 32

# Comma separated. Only these email domains, or an address with a pending organisation
# invitation, can create an account. Leave empty for open registration.
SIGNUP_ALLOWED_EMAIL_DOMAINS=

NEXT_PUBLIC_IS_CLOUD=false
